# Supabase (Project settings > API)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Your public site address (no trailing slash). Local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Chapa
CHAPA_SECRET_KEY=CHASECK-xxxxxxxx

# Long random string used to sign staff login cookies
JWT_SECRET=change-me-to-a-long-random-string

# Email (Resend). EMAIL_FROM must be on a domain you verified in Resend
RESEND_API_KEY=re_xxxxxxxx
EMAIL_FROM=EK Guest House <bookings@yourdomain.com>

# Used once by: npm run create-admin
ADMIN_NAME=Owner
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=choose-a-strong-password
